# ==============================================================================
# SHOESY STORE - Environment Variables Configuration
# ==============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control!

# ------------------------------------------------------------------------------
# 1. Database Configuration (Neon Serverless PostgreSQL)
# ------------------------------------------------------------------------------
# Pooled connection string (used by Prisma Client in serverless runtime)
DATABASE_URL="postgresql://username:password@ep-sample-pooler.region.neon.tech/shoesy?sslmode=require&pgbouncer=true"

# Direct unpooled connection string (used by Prisma Migrate / CLI migrations)
DIRECT_URL="postgresql://username:password@ep-sample.region.neon.tech/shoesy?sslmode=require"

# ------------------------------------------------------------------------------
# 2. NextAuth.js / Auth.js Configuration
# ------------------------------------------------------------------------------
# Canonical URL of your site (http://localhost:3000 in dev, https://your-domain.vercel.app in prod)
NEXTAUTH_URL="http://localhost:3000"

# 32+ character random secret used to sign and encrypt session JWTs
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-random-key-at-least-32-chars"

# ------------------------------------------------------------------------------
# 3. Razorpay Payments (Test Mode)
# ------------------------------------------------------------------------------
# Public Key ID for client-side Razorpay modal (starts with rzp_test_...)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_yourKeyIdHere"

# Secret Key for server-side order creation and HMAC-SHA256 signature verification
RAZORPAY_KEY_SECRET="yourRazorpaySecretKeyHere"

# ------------------------------------------------------------------------------
# 4. Public App Configuration
# ------------------------------------------------------------------------------
# Base URL for public metadata, OpenGraph cards, and absolute canonical links
NEXT_PUBLIC_APP_URL="http://localhost:3000"
